<Project Sdk="Microsoft.NET.Sdk">
  <!-- Out-of-server tests for the pure core: selection math, direction maths, argument splitting, pattern and mask compilers, job bytes and sessions.
       The core has no dependency on the plugin API, so the tests compile it in directly. No NuGet packages. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>WorldEdit.Tests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="../../src/Core/**/*.cs" />
  </ItemGroup>
</Project>
